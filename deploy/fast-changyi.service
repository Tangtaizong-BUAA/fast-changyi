[Unit]
Description=fast-changyi OSS file transfer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fast-changyi
Group=fast-changyi
WorkingDirectory=/opt/fast-changyi/current
EnvironmentFile=/etc/fast-changyi/env
ExecStart=/usr/local/bin/node /opt/fast-changyi/current/server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fast-changyi
MemoryMax=512M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
