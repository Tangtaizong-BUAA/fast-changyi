NODE_ENV=development
HOST=127.0.0.1
PORT=8810
DATA_DIR=./data
PUBLIC_BASE_URL=http://127.0.0.1:8810/transfer

# Replace this with your private OSS bucket. Keep region/endpoints consistent.
OSS_REGION=oss-cn-beijing
OSS_BUCKET=your-oss-bucket
OSS_EXTERNAL_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# Use the public endpoint for local development. On ECS in the same region,
# change to https://oss-cn-beijing-internal.aliyuncs.com for internal reads.
OSS_INTERNAL_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
STS_ENDPOINT=https://sts.cn-beijing.aliyuncs.com
STS_ROLE_ARN=acs:ram::<account-id>:role/<upload-role-name>

# Generate before production: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep this stable after deployment: it signs existing share links.
SHARE_SECRET=
MAX_FILE_BYTES=2199023255552

# Production uses an ECS RAM instance role. For local cloud development only,
# obtain your own least-privilege credentials and set them in your untracked .env:
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_SECURITY_TOKEN=
